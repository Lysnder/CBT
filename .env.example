# Kopyala: cp .env.example .env  — değerler yalnızca lokal geliştirme içindir.
DATABASE_URL=postgres://cbt:cbt_local@localhost:5432/cbt
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=local_dev_master_key_change_me
AUTH_SECRET=local_dev_auth_secret_change_me_32chars
