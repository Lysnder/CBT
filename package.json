{
  "name": "cbt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter worker dev",
    "test": "vitest run",
    "lint": "eslint . && pnpm typecheck",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cbt/db db:generate",
    "db:migrate": "pnpm --filter @cbt/db db:migrate",
    "db:seed": "pnpm --filter @cbt/db db:seed"
  },
  "devDependencies": {
    "@cbt/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
